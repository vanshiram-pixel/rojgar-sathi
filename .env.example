# Public browser configuration (safe to expose only the anon/publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only integrations. Add real values only in local .env.local or
# the Vercel server environment; NEVER use NEXT_PUBLIC_ for these secrets.
# Required for sending admin-triggered email alerts:
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Required for admin-only AI draft assistance:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required for the server-side recipient lookup in email alerts.
# Keep this key server-side; never place it in client/browser variables.
SUPABASE_SERVICE_ROLE_KEY=
